# Abacus ClawKit Environment Variables
# Copy this file to .env and customize as needed

# Database location (default: ./data/abacus.duckdb)
# ABACUS_DB_PATH=/path/to/your/abacus.duckdb

# Import folder for CSV files (default: ./imports)
# ABACUS_IMPORT_DIR=/path/to/your/import/folder

# Example for iCloud folder:
# ABACUS_IMPORT_DIR=/Users/yourname/Library/Mobile Documents/com~apple~CloudDocs/abacus-imports
